# Dependencies
node_modules/
host/node_modules/

# Build output
host/dist/
guest/target/
# Cargo workspace target (P1 service crate). The `target-*/` glob
# catches CARGO_TARGET_DIR overrides (e.g. `target-codex-check/`)
# that some local toolchains drop alongside the default target dir.
target/
target-*/

# Coverage reports (vitest v8 provider)
host/coverage/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Agent-local settings
.claude/settings.json
# Per-user Claude Code overrides (project convention: *.local.json is
# never committed). We caught this leaking in once; pin it explicitly.
.claude/settings.local.json
# EnterWorktree-managed working trees (each is its own nested git
# checkout — definitely not a tracked artifact).
.claude/worktrees/

# Environment
.env
.env.local

# Test output (root-level only, not src/output/)
/output/
*.png
!scenarios/**/*.png

# Release-packaging artifacts
host/*.tgz
*.tar.gz

# Local logs from dev / scenario runs
*.log

# Control-plane local state (default paths when an operator runs
# `signalman serve` from the repo root). The SQLite WAL/SHM
# variants get created automatically and are noisy in `git status`.
signalman.db
signalman.db-shm
signalman.db-wal
.signalman/blobs/
.signalman/recordings/

# Certificates (generated, not committed)
certs/*.pem
certs/*.key
certs/*.crt
!certs/.gitkeep

# BEGIN LOOM generated-artifacts
# Generated Loom coordination and runtime state
.loom/index/
.loom/tasks/
.loom/handoffs/
.loom/follow-through/
.loom/digests/
.loom/metrics/
.loom/review/
# END LOOM generated-artifacts

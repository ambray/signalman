{
  "name": "@signalman/host",
  "version": "0.1.0",
  "description": "Signalman host: agent-first VM scenario runner + tag-driven release-lifecycle control plane. Hyper-V/Tart/VMware backends; in-process or HTTP control plane; SQLite or Postgres storage; local-FS or S3 blob driver.",
  "type": "module",
  "main": "dist/server.js",
  "bin": {
    "signalman": "dist/cli.js"
  },
  "homepage": "https://signalman.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ambray/signalman.git",
    "directory": "host"
  },
  "bugs": {
    "url": "https://github.com/ambray/signalman/issues"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-assets.mjs",
    "dev": "tsx src/server.ts",
    "cli": "tsx src/cli.ts",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "testing",
    "vm",
    "orchestration",
    "automation",
    "hyper-v",
    "scenario-runner",
    "release-pipeline",
    "control-plane",
    "build-system",
    "ed25519",
    "signed-releases",
    "devops",
    "ci"
  ],
  "author": "Signalman Contributors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "marked": "^12.0.0",
    "pg": "^8.13.0",
    "ulid": "^2.3.0",
    "yaml": "^2.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.0.0",
    "pg-mem": "^3.0.4",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.58.2",
    "vitest": "^3.0.0"
  }
}
